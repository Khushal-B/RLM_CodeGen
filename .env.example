# Copy to .env and fill in. Loaded automatically by `python -m rlmc.cli run`.

# OpenRouter is the default backend. It is the only one whose usage payload
# carries real USD cost, which the cost-matched results table needs.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: only if you use --backend openai
# OPENAI_API_KEY=sk-...

# Optional: path to a clone of NL2Repo-Bench, for --benchmark nl2repo
# NL2REPO_ROOT=../NL2RepoBench

# NVIDIA NIM (free tier). Slow: ~175s/call at time of writing, so use
# --request-timeout-s 900 and expect latency, not rate, to be the bottleneck.
NVIDIA_API_KEY=nvapi-...
